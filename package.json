{
  "name": "melonis-uptime",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "TSX_TSCONFIG_PATH=./tsconfig.server.json tsx server.ts",
    "build": "tsc -p tsconfig.server.json",
    "start": "NODE_ENV=production node dist/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "TSX_TSCONFIG_PATH=./tsconfig.server.json node --import tsx --test tests/*.test.ts",
    "test:redis": "TSX_TSCONFIG_PATH=./tsconfig.server.json node --import tsx --test tests/redis.integration.test.ts",
    "test:all": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "mysql2": "^3.23.2",
    "redis": "^6.2.0"
  },
  "devDependencies": {
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tsx": "^4.23.11",
    "typescript": "^5.9.3"
  }
}
